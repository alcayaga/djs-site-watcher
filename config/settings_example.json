{
  "interval": 5,
  "requestTimeout": 10000,
  "retryLimit": 2,
  "uptimeKumaUrl": "",
  "defaultChannelId": "YOUR_DEFAULT_CHANNEL_ID",
  "monitors": [
    {
      "name": "AppleEsim",
      "enabled": true,
      "channelId": "YOUR_CHANNEL_ID"
    },
    {
      "name": "Carrier",
      "enabled": true,
      "channelId": "YOUR_CHANNEL_ID"
    },
    {
      "name": "AppleFeature:iOS",
      "enabled": true,
      "url": "https://www.apple.com/ios/feature-availability/",
      "file": "./config/apple_features_ios.json",
      "channelId": "YOUR_CHANNEL_ID"
    },
    {
      "name": "AppleFeature:macOS",
      "enabled": true,
      "url": "https://www.apple.com/macos/feature-availability/",
      "file": "./config/apple_features_macos.json",
      "channelId": "YOUR_CHANNEL_ID"
    },
    {
      "name": "AppleFeature:watchOS",
      "enabled": true,
      "url": "https://www.apple.com/watchos/feature-availability/",
      "file": "./config/apple_features_watchos.json",
      "channelId": "YOUR_CHANNEL_ID"
    },
    {
      "name": "ApplePay",
      "enabled": true,
      "channelId": "YOUR_CHANNEL_ID"
    },
    {
      "name": "Deal",
      "enabled": true,
      "channelId": "YOUR_CHANNEL_ID",
      "apiDelay": 5000,
      "verboseLogging": false
    },
    {
      "name": "Site",
      "enabled": true,
      "channelId": "YOUR_CHANNEL_ID"
    }
  ],
  "channels": [
    {
      "name": "QA",
      "handler": "QAChannel",
      "enabled": true,
      "channelId": "YOUR_QA_CHANNEL_ID",
      "responseDelay": 5000
    },
    {
      "name": "Deals",
      "handler": "DealsChannel",
      "enabled": true,
      "channelId": "YOUR_DEALS_CHANNEL_ID"
    }
  ]
}
